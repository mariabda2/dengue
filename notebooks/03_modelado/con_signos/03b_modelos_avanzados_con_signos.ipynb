   "source": [
    "# 03b · Modelos Avanzados — Dengue Con Signos de Alarma (DCSA)\n",
    "**Proyecto:** Predicción de Hospitalización por Dengue — Bucaramanga  \n",
    "**Fase:** Modelado predictivo — estrato DCSA  \n",
    "**Origen:** `DengueConSignosTodosSintomas.ipynb` — secciones de modelado ML\n",
    "\n",
    "---\n",
    "\n",
    "## Propósito\n",
    "\n",
    "Este notebook entrena y evalúa el portafolio de modelos **predictivos** para el estrato\n",
    "Dengue Con Signos de Alarma (DCSA). A diferencia del notebook 02b (modelos explicativos),\n",
    "aquí el objetivo es **maximizar la capacidad de clasificación**.\n",
    "\n",
    "### Portafolio de modelos\n",
    "- Regresión Logística (baseline interpretable)\n",
    "- Random Forest\n",
    "- Extra Trees\n",
    "- Gradient Boosting\n",
    "- XGBoost\n",
    "- LightGBM\n",
    "- CatBoost\n",
    "\n",
    "### Diseño experimental\n",
    "- **Partición:** 80/20 estratificada (preserva proporción de clases)\n",
    "- **Validación:** 5-fold CV estratificada sobre train\n",
    "- **Tratamiento del desbalance:** SMOTE (sobremuestreo sintético) + umbral óptimo en test\n",
    "- **Métrica primaria:** F1-score (clase positiva = hospitalizado)\n",
    "- **Métricas secundarias:** AUC-ROC, Balanced Accuracy, Precision, Recall\n",
    "\n",
    "> **¿Por qué SMOTE y no solo pesos de clase?** En DCSA el desbalance es moderado\n",
    "> (65% vs 35%), pero en DSSA el desbalance es severo (~92% vs 8%). SMOTE genera\n",
    "> ejemplos sintéticos interpolando en el espacio de características, lo que puede\n",
    "> mejorar la frontera de decisión. Los pesos de clase son equivalentes teóricamente\n",
    "> pero en la práctica SMOTE tiende a estabilizar más el entrenamiento de los boosters.\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# IMPORTACIONES\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "import sys\n",
    "sys.path.insert(0, \"../../../src\")\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "import seaborn as sns\n",
    "import joblib\n",
    "import warnings\n",
    "from pathlib import Path\n",
    "\n",
    "from sklearn.model_selection import train_test_split, StratifiedKFold, cross_validate\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.ensemble import RandomForestClassifier, ExtraTreesClassifier, GradientBoostingClassifier\n",
    "from xgboost import XGBClassifier\n",
    "from lightgbm import LGBMClassifier\n",
    "from catboost import CatBoostClassifier\n",
    "from imblearn.over_sampling import SMOTE\n",
    "from imblearn.pipeline import Pipeline as ImbPipeline\n",
    "\n",
    "from sklearn.metrics import (\n",
    "    f1_score, roc_auc_score, balanced_accuracy_score,\n",
    "    precision_score, recall_score, average_precision_score,\n",
    "    confusion_matrix, RocCurveDisplay, PrecisionRecallDisplay,\n",
    "    classification_report, ConfusionMatrixDisplay\n",
    ")\n",
    "from sklearn.inspection import permutation_importance\n",
    "from sklearn.metrics import make_scorer\n",
    "\n",
    "import config\n",
    "from config import (\n",
    "    DATA_INTERIM, DATA_PROC, OUT_FIGURES, OUT_TABLES,\n",
    "    CHECKPOINTS, OUT_MODELS, COLORS,\n",
    "    RANDOM_STATE, TEST_SIZE, CV_FOLDS, TARGET_COL,\n",
    "    SIGNOS_ALARMA, SINTOMAS_GENERALES, VARIABLES_DEMOGRAFICAS\n",
    ")\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "%matplotlib inline\n",
    "\n",
    "plt.rcParams.update({\n",
    "    \"figure.dpi\": 150, \"savefig.dpi\": 300,\n",
    "    \"figure.facecolor\": \"white\", \"axes.facecolor\": \"white\",\n",
    "    \"axes.spines.top\": False, \"axes.spines.right\": False,\n",
    "    \"axes.titlesize\": 13, \"axes.titleweight\": \"bold\",\n",
    "    \"axes.labelsize\": 11, \"xtick.labelsize\": 9,\n",
    "    \"ytick.labelsize\": 9, \"legend.frameon\": False,\n",
    "})\n",
    "\n",
    "df_con = joblib.load(DATA_INTERIM / \"datos_con_signos.pkl\")\n",
    "print(f\"✅ DCSA cargado: {df_con.shape[0]:,} registros\")\n",
    "print(f\"   Hospitalización: {df_con[TARGET_COL].mean():.1%}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Preparación de features y partición"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# SELECCIÓN DE FEATURES\n",
    "# Se incluyen tres grupos de variables:\n",
    "# 1. Clínicas: síntomas generales + signos de alarma (recodificadas 1/0)\n",
    "# 2. Demográficas: sexo, grupo etario, tipo aseguramiento, estrato\n",
    "# 3. Temporales: año (para controlar la ruptura estructural 2017-2020)\n",
    "#\n",
    "# Se EXCLUYE CLASFINAL para evitar data leakage (sería la variable más\n",
    "# importante por su relación directa con la hospitalización, pero no está\n",
    "# disponible como predictor al momento de la consulta inicial).\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "vars_clinicas = SINTOMAS_GENERALES + SIGNOS_ALARMA\n",
    "vars_demo     = [\"SEXO_\", \"DEF_CLAS_EDAD\", \"TIP_SS_\", \"ESTRATO_\", \"GP_GESTAN\"]\n",
    "vars_temporal = [\"AÑO\", \"SEMANA\"]\n",
    "\n",
    "FEATURES = vars_clinicas + vars_demo + vars_temporal\n",
    "\n",
    "# Preparar dataset\n",
    "df_model = df_con[FEATURES + [TARGET_COL]].copy()\n",
    "\n",
    "# Recodificar clínicas (1=presente, 0=ausente; era 1/2 en SIVIGILA)\n",
    "for var in vars_clinicas:\n",
    "    df_model[var] = df_model[var].map({1: 1, 2: 0})\n",
    "\n",
    "df_model = df_model.dropna(subset=[TARGET_COL])\n",
    "\n",
    "X = df_model[FEATURES]\n",
    "y = df_model[TARGET_COL].astype(int)\n",
    "\n",
    "# Partición estratificada\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=TEST_SIZE,\n",
    "    random_state=RANDOM_STATE, stratify=y\n",
    ")\n",
    "\n",
    "print(f\"Train: {X_train.shape[0]:,} | Test: {X_test.shape[0]:,}\")\n",
    "print(f\"Prevalencia en train: {y_train.mean():.1%} | test: {y_test.mean():.1%}\")\n",
    "\n",
    "# Guardar particiones para evaluación final\n",
    "joblib.dump((X_train, X_test, y_train, y_test, FEATURES),\n",
    "            DATA_PROC / \"particion_DCSA.pkl\")\n",
    "print(\"✅ Partición guardada\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# PREPROCESADOR\n",
    "# Las variables clínicas y de gestación son binarias (0/1), no requieren escala.\n",
    "# Las demográficas y temporales son numéricas y se escalan para LR y modelos\n",
    "# sensibles a la magnitud.\n",
    "# La imputación por mediana es robusta a outliers (mejor que media en datos clínicos).\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "vars_numericas = vars_demo + vars_temporal\n",
    "vars_binarias  = vars_clinicas\n",
    "\n",
    "preprocesador = ColumnTransformer([\n",
    "    (\"num\", Pipeline([\n",
    "        (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
    "        (\"scaler\",  StandardScaler()),\n",
    "    ]), vars_numericas),\n",
    "    (\"bin\", SimpleImputer(strategy=\"most_frequent\"), vars_binarias),\n",
    "], remainder=\"drop\")\n",
    "\n",
    "print(\"✅ Preprocesador configurado\")\n",
    "print(f\"   Variables numéricas: {len(vars_numericas)}\")\n",
    "print(f\"   Variables binarias:  {len(vars_binarias)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Entrenamiento del portafolio de modelos"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# DEFINICIÓN DEL PORTAFOLIO\n",
    "# Cada modelo se envuelve en un ImbPipeline con SMOTE para tratar el desbalance.\n",
    "# Los hiperparámetros son defaults orientados a un buen compromiso velocidad/performance.\n",
    "# El notebook 03c realizará búsqueda de hiperparámetros sobre los 2 mejores modelos.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def make_pipeline(clasificador):\n",
    "    \"\"\"Envuelve preprocesador + SMOTE + clasificador en un pipeline.\"\"\"\n",
    "    return ImbPipeline([\n",
    "        (\"preprocesador\", preprocesador),\n",
    "        (\"smote\",         SMOTE(random_state=RANDOM_STATE, k_neighbors=5)),\n",
    "        (\"clf\",           clasificador),\n",
    "    ])\n",
    "\n",
    "portafolio = {\n",
    "    \"Logistic Regression\": make_pipeline(\n",
    "        LogisticRegression(max_iter=1000, C=1.0, random_state=RANDOM_STATE)\n",
    "    ),\n",
    "    \"Random Forest\": make_pipeline(\n",
    "        RandomForestClassifier(n_estimators=300, max_depth=10,\n",
    "                               random_state=RANDOM_STATE, n_jobs=-1)\n",
    "    ),\n",
    "    \"Extra Trees\": make_pipeline(\n",
    "        ExtraTreesClassifier(n_estimators=300, max_depth=10,\n",
    "                             random_state=RANDOM_STATE, n_jobs=-1)\n",
    "    ),\n",
    "    \"Gradient Boosting\": make_pipeline(\n",
    "        GradientBoostingClassifier(n_estimators=200, learning_rate=0.05,\n",
    "                                   max_depth=4, random_state=RANDOM_STATE)\n",
    "    ),\n",
    "    \"XGBoost\": make_pipeline(\n",
    "        XGBClassifier(n_estimators=300, learning_rate=0.05, max_depth=5,\n",
    "                      use_label_encoder=False, eval_metric=\"logloss\",\n",
    "                      random_state=RANDOM_STATE, n_jobs=-1, verbosity=0)\n",
    "    ),\n",
    "    \"LightGBM\": make_pipeline(\n",
    "        LGBMClassifier(n_estimators=300, learning_rate=0.05, max_depth=6,\n",
    "                       num_leaves=31, random_state=RANDOM_STATE,\n",
    "                       n_jobs=-1, verbose=-1)\n",
    "    ),\n",
    "    \"CatBoost\": make_pipeline(\n",
    "        CatBoostClassifier(iterations=300, learning_rate=0.05, depth=6,\n",
    "                           random_seed=RANDOM_STATE, verbose=0)\n",
    "    ),\n",
    "}\n",
    "\n",
    "print(f\"✅ Portafolio configurado: {len(portafolio)} modelos\")\n",
    "for nombre in portafolio:\n",
    "    print(f\"   • {nombre}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# VALIDACIÓN CRUZADA — 5-FOLD ESTRATIFICADA\n",
    "# Se evalúa en CV antes de ver el test set. Esto previene el ajuste de\n",
    "# decisiones de modelado al test set (lo que inflaría el rendimiento reportado).\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "cv = StratifiedKFold(n_splits=CV_FOLDS, shuffle=True, random_state=RANDOM_STATE)\n",
    "\n",
    "scoring = {\n",
    "    \"f1\":                make_scorer(f1_score, pos_label=1),\n",
    "    \"roc_auc\":           make_scorer(roc_auc_score, needs_proba=True),\n",
    "    \"balanced_accuracy\": make_scorer(balanced_accuracy_score),\n",
    "    \"precision\":         make_scorer(precision_score, pos_label=1, zero_division=0),\n",
    "    \"recall\":            make_scorer(recall_score, pos_label=1, zero_division=0),\n",
    "    \"average_precision\": make_scorer(average_precision_score, needs_proba=True),\n",
    "}\n",
    "\n",
    "resultados_cv = {}\n",
    "\n",
    "for nombre, pipeline in portafolio.items():\n",
    "    print(f\"\\nEntrenando {nombre}...\", end=\" \")\n",
    "    cv_result = cross_validate(\n",
    "        pipeline, X_train, y_train,\n",
    "        cv=cv, scoring=scoring,\n",
    "        n_jobs=-1, return_train_score=False\n",
    "    )\n",
    "    resultados_cv[nombre] = {\n",
    "        metric: {\n",
    "            \"mean\": cv_result[f\"test_{metric}\"].mean(),\n",
    "            \"std\":  cv_result[f\"test_{metric}\"].std()\n",
    "        }\n",
    "        for metric in scoring.keys()\n",
    "    }\n",
    "    print(f\"F1={resultados_cv[nombre]['f1']['mean']:.3f} ± {resultados_cv[nombre]['f1']['std']:.3f}\")\n",
    "\n",
    "print(\"\\n✅ Validación cruzada completa\")\n",
    "joblib.dump(resultados_cv, CHECKPOINTS / \"03b_resultados_cv_DCSA.pkl\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Visualización de resultados de CV"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# TABLA RESUMEN DE CV Y GRÁFICO DE COMPARACIÓN\n",
    "# Se visualizan media ± 1 std de cada métrica por modelo.\n",
    "# La barra de error representa la variabilidad entre folds — un modelo con\n",
    "# alta media pero alta std puede ser inestable según la partición.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "metricas_mostrar = [\"f1\", \"roc_auc\", \"balanced_accuracy\", \"precision\", \"recall\"]\n",
    "\n",
    "filas = []\n",
    "for nombre, res in resultados_cv.items():\n",
    "    fila = {\"Modelo\": nombre}\n",
    "    for m in metricas_mostrar:\n",
    "        fila[f\"{m}_mean\"] = round(res[m][\"mean\"], 4)\n",
    "        fila[f\"{m}_std\"]  = round(res[m][\"std\"], 4)\n",
    "    filas.append(fila)\n",
    "\n",
    "tabla_cv = pd.DataFrame(filas).sort_values(\"f1_mean\", ascending=False)\n",
    "display(tabla_cv)\n",
    "tabla_cv.to_csv(OUT_TABLES / \"cv_resultados_DCSA.csv\", index=False)\n",
    "\n",
    "# ── Figura: Comparación de modelos ───────────────────────────────────────────\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
    "\n",
    "colores_modelos = [\n",
    "    \"#2C7BB6\", \"#1A9850\", \"#66C2A5\", \"#F46D43\",\n",
    "    \"#D73027\", \"#A50026\", \"#762A83\"\n",
    "]\n",
    "\n",
    "# Panel A: F1 y AUC-ROC\n",
    "ax = axes[0]\n",
    "x = np.arange(len(tabla_cv))\n",
    "width = 0.35\n",
    "\n",
    "bars1 = ax.bar(x - width/2, tabla_cv[\"f1_mean\"], width,\n",
    "               yerr=tabla_cv[\"f1_std\"],\n",
    "               color=[colores_modelos[i % len(colores_modelos)] for i in range(len(tabla_cv))],\n",
    "               alpha=0.85, capsize=4, label=\"F1-score\", edgecolor=\"white\")\n",
    "bars2 = ax.bar(x + width/2, tabla_cv[\"roc_auc_mean\"], width,\n",
    "               yerr=tabla_cv[\"roc_auc_std\"],\n",
    "               color=[colores_modelos[i % len(colores_modelos)] for i in range(len(tabla_cv))],\n",
    "               alpha=0.5, capsize=4, label=\"AUC-ROC\", edgecolor=\"white\", hatch=\"//\")\n",
    "\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels(tabla_cv[\"Modelo\"], rotation=40, ha=\"right\", fontsize=9)\n",
    "ax.set_ylabel(\"Puntuación (CV 5-fold)\")\n",
    "ax.set_title(\"A. F1-score y AUC-ROC por modelo\")\n",
    "ax.legend()\n",
    "ax.set_ylim(0, 1.05)\n",
    "ax.grid(axis=\"y\", alpha=0.3)\n",
    "\n",
    "# Panel B: Precision vs Recall\n",
    "ax = axes[1]\n",
    "for i, (_, row) in enumerate(tabla_cv.iterrows()):\n",
    "    ax.errorbar(\n",
    "        row[\"precision_mean\"], row[\"recall_mean\"],\n",
    "        xerr=row[\"precision_std\"], yerr=row[\"recall_std\"],\n",
    "        fmt=\"o\", markersize=10, capsize=4,\n",
    "        color=colores_modelos[i % len(colores_modelos)],\n",
    "        label=row[\"Modelo\"]\n",
    "    )\n",
    "\n",
    "ax.set_xlabel(\"Precisión\")\n",
    "ax.set_ylabel(\"Recall (Sensibilidad)\")\n",
    "ax.set_title(\"B. Precision vs Recall (trade-off)\")\n",
    "ax.legend(fontsize=8, bbox_to_anchor=(1.02, 1))\n",
    "ax.grid(alpha=0.3)\n",
    "# Línea de F1 = 0.7\n",
    "prec_range = np.linspace(0.01, 0.99, 100)\n",
    "for f1_target in [0.65, 0.70, 0.75]:\n",
    "    rec_line = (f1_target * prec_range) / (2 * prec_range - f1_target)\n",
    "    mask = (rec_line > 0) & (rec_line < 1)\n",
    "    ax.plot(prec_range[mask], rec_line[mask], \"--\", alpha=0.3, color=\"gray\", linewidth=1)\n",
    "    ax.text(0.98, rec_line[mask][-1] if len(rec_line[mask]) > 0 else 0.5,\n",
    "            f\"F1={f1_target}\", fontsize=7, color=\"gray\", ha=\"right\")\n",
    "\n",
    "plt.suptitle(\"Comparación de modelos — Validación cruzada 5-fold\\nDengue con signos de alarma (DCSA)\",\n",
    "             fontsize=13, fontweight=\"bold\")\n",
    "plt.tight_layout()\n",
    "\n",
    "fig.savefig(OUT_FIGURES / \"08_comparacion_modelos_DCSA.png\",\n",
    "            dpi=300, bbox_inches=\"tight\", facecolor=\"white\")\n",
    "plt.show()\n",
    "print(\"✅ Figura guardada\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Entrenamiento final y evaluación en test set"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# SELECCIÓN Y ENTRENAMIENTO FINAL\n",
    "# Se seleccionan los 3 mejores modelos por F1-CV y se entrenan sobre TODO train.\n",
    "# El test set se usa UNA SOLA VEZ al final (aquí) para la evaluación definitiva.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "top3_nombres = tabla_cv.head(3)[\"Modelo\"].tolist()\n",
    "print(f\"Top 3 modelos por F1-CV: {top3_nombres}\")\n",
    "\n",
    "modelos_entrenados = {}\n",
    "resultados_test = []\n",
    "\n",
    "for nombre in top3_nombres:\n",
    "    print(f\"\\nEntrenando {nombre} sobre X_train completo...\")\n",
    "    pipeline = portafolio[nombre]\n",
    "    pipeline.fit(X_train, y_train)\n",
    "\n",
    "    y_prob  = pipeline.predict_proba(X_test)[:, 1]\n",
    "    y_pred  = pipeline.predict(X_test)\n",
    "\n",
    "    resultados_test.append({\n",
    "        \"Modelo\":          nombre,\n",
    "        \"F1\":              round(f1_score(y_test, y_pred), 4),\n",
    "        \"AUC_ROC\":         round(roc_auc_score(y_test, y_prob), 4),\n",
    "        \"Balanced_Acc\":    round(balanced_accuracy_score(y_test, y_pred), 4),\n",
    "        \"Precision\":       round(precision_score(y_test, y_pred, zero_division=0), 4),\n",
    "        \"Recall\":          round(recall_score(y_test, y_pred), 4),\n",
    "        \"Avg_Precision\":   round(average_precision_score(y_test, y_prob), 4),\n",
    "    })\n",
    "\n",
    "    modelos_entrenados[nombre] = {\"pipeline\": pipeline, \"y_prob\": y_prob, \"y_pred\": y_pred}\n",
    "    print(f\"  F1-test: {resultados_test[-1]['F1']:.4f} | AUC: {resultados_test[-1]['AUC_ROC']:.4f}\")\n",
    "\n",
    "tabla_test = pd.DataFrame(resultados_test).sort_values(\"F1\", ascending=False)\n",
    "display(tabla_test)\n",
    "tabla_test.to_csv(OUT_TABLES / \"resultados_test_DCSA.csv\", index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# CURVAS ROC Y PRECISION-RECALL\n",
    "# Se grafican ambas curvas porque:\n",
    "# - AUC-ROC es útil cuando el desbalance es moderado (DCSA: 65/35)\n",
    "# - AUC-PR es más informativo cuando la clase positiva es rara (DSSA: 8%)\n",
    "# Para DCSA ambas son relevantes; para DSSA se priorizará AUC-PR.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "colores_top3 = [COLORS[\"secondary\"], COLORS[\"primary\"], COLORS[\"accent\"]]\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
    "\n",
    "for i, (nombre, res) in enumerate(modelos_entrenados.items()):\n",
    "    color = colores_top3[i]\n",
    "    RocCurveDisplay.from_predictions(\n",
    "        y_test, res[\"y_prob\"],\n",
    "        name=nombre, color=color, ax=axes[0]\n",
    "    )\n",
    "    PrecisionRecallDisplay.from_predictions(\n",
    "        y_test, res[\"y_prob\"],\n",
    "        name=nombre, color=color, ax=axes[1]\n",
    "    )\n",
    "\n",
    "axes[0].plot([0, 1], [0, 1], \"k--\", alpha=0.4)\n",
    "axes[0].set_title(\"A. Curvas ROC — Top 3 modelos (DCSA)\")\n",
    "axes[0].grid(alpha=0.3)\n",
    "\n",
    "prev = y_test.mean()\n",
    "axes[1].axhline(prev, linestyle=\"--\", color=\"gray\", alpha=0.5, label=f\"Prevalencia: {prev:.1%}\")\n",
    "axes[1].set_title(\"B. Curvas Precision-Recall — Top 3 modelos (DCSA)\")\n",
    "axes[1].grid(alpha=0.3)\n",
    "axes[1].legend(fontsize=8)\n",
    "\n",
    "plt.suptitle(\"Evaluación en conjunto de prueba — Dengue con signos de alarma\",\n",
    "             fontsize=13, fontweight=\"bold\")\n",
    "plt.tight_layout()\n",
    "\n",
    "fig.savefig(OUT_FIGURES / \"09_curvas_ROC_PR_DCSA.png\",\n",
    "            dpi=300, bbox_inches=\"tight\", facecolor=\"white\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# MATRICES DE CONFUSIÓN\n",
    "# Permiten cuantificar el balance entre FP y FN.\n",
    "# En el contexto clínico:\n",
    "# - FN (hospitalizado predicho como no hospitalizado): riesgo de alta prematura\n",
    "# - FP (no hospitalizado predicho como hospitalizado): ocupación innecesaria de camas\n",
    "# El trade-off clínico depende del contexto: en brotes epidémicos con\n",
    "# sobrecarga hospitalaria, reducir FP puede ser prioritario; en contexto\n",
    "# de recursos disponibles, reducir FN (no perder casos graves) es prioritario.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "fig, axes = plt.subplots(1, len(modelos_entrenados), figsize=(14, 4))\n",
    "\n",
    "for i, (nombre, res) in enumerate(modelos_entrenados.items()):\n",
    "    ax = axes[i] if len(modelos_entrenados) > 1 else axes\n",
    "    ConfusionMatrixDisplay.from_predictions(\n",
    "        y_test, res[\"y_pred\"],\n",
    "        display_labels=[\"No hosp.\", \"Hospitalizado\"],\n",
    "        cmap=\"Blues\", ax=ax, colorbar=False\n",
    "    )\n",
    "    f1 = f1_score(y_test, res[\"y_pred\"])\n",
    "    ax.set_title(f\"{nombre}\\nF1={f1:.3f}\", fontsize=10, fontweight=\"bold\")\n",
    "\n",
    "plt.suptitle(\"Matrices de confusión — conjunto de prueba (DCSA)\",\n",
    "             fontsize=12, fontweight=\"bold\")\n",
    "plt.tight_layout()\n",
    "\n",
    "fig.savefig(OUT_FIGURES / \"10_matrices_confusion_DCSA.png\",\n",
    "            dpi=300, bbox_inches=\"tight\", facecolor=\"white\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Importancia de variables — Permutation Importance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# PERMUTATION IMPORTANCE\n",
    "# Se usa permutation importance (no feature importance intrínseca del árbol)\n",
    "# porque:\n",
    "# 1. Es agnóstica del modelo (comparable entre todos los modelos del portafolio)\n",
    "# 2. Evalúa el impacto real en la métrica de interés (F1) al permutar cada variable\n",
    "# 3. Las importancias intrínsecas de Random Forest sobreestiman variables\n",
    "#    con alta cardinalidad o que están correlacionadas con otras\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "mejor_nombre = tabla_test.iloc[0][\"Modelo\"]\n",
    "mejor_pipeline = modelos_entrenados[mejor_nombre][\"pipeline\"]\n",
    "\n",
    "# Transformar X_test por el preprocesador del pipeline\n",
    "# (permutation_importance necesita el modelo completo o la X ya transformada)\n",
    "print(f\"Calculando permutation importance para: {mejor_nombre}\")\n",
    "print(\"Esto puede tardar ~2 minutos...\")\n",
    "\n",
    "perm_imp = permutation_importance(\n",
    "    mejor_pipeline, X_test, y_test,\n",
    "    n_repeats=20, random_state=RANDOM_STATE,\n",
    "    scoring=\"f1\", n_jobs=-1\n",
    ")\n",
    "\n",
    "df_imp = pd.DataFrame({\n",
    "    \"Variable\":  FEATURES,\n",
    "    \"Importancia\": perm_imp.importances_mean,\n",
    "    \"Std\":       perm_imp.importances_std,\n",
    "}).sort_values(\"Importancia\", ascending=False)\n",
    "\n",
    "df_imp[\"Tipo\"] = [\n",
    "    \"Signo de alarma\" if v in SIGNOS_ALARMA\n",
    "    else (\"Síntoma general\" if v in SINTOMAS_GENERALES else \"Demográfico/Temporal\")\n",
    "    for v in df_imp[\"Variable\"]\n",
    "]\n",
    "\n",
    "display(df_imp.head(15))\n",
    "df_imp.to_csv(OUT_TABLES / \"permutation_importance_DCSA.csv\", index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# GRÁFICO DE IMPORTANCIA DE VARIABLES\n",
    "# Se muestran las top 15 variables por permutation importance.\n",
    "# Las barras de error representan la variabilidad entre repeticiones.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "color_mapa = {\n",
    "    \"Signo de alarma\":       COLORS[\"con_signos\"],\n",
    "    \"Síntoma general\":       COLORS[\"sin_signos\"],\n",
    "    \"Demográfico/Temporal\":  COLORS[\"accent\"],\n",
    "}\n",
    "\n",
    "df_top = df_imp.head(15)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 7))\n",
    "\n",
    "colores_barras = [color_mapa[t] for t in df_top[\"Tipo\"]]\n",
    "\n",
    "bars = ax.barh(\n",
    "    df_top[\"Variable\"][::-1],\n",
    "    df_top[\"Importancia\"][::-1],\n",
    "    xerr=df_top[\"Std\"][::-1],\n",
    "    color=colores_barras[::-1],\n",
    "    capsize=4, alpha=0.85, edgecolor=\"white\"\n",
    ")\n",
    "\n",
    "ax.set_xlabel(\"Reducción en F1-score (permutation importance)\")\n",
    "ax.set_title(\n",
    "    f\"Importancia de variables — {mejor_nombre}\\n\"\n",
    "    \"Dengue con signos de alarma (DCSA)\"\n",
    ")\n",
    "\n",
    "from matplotlib.patches import Patch\n",
    "leyenda = [Patch(color=c, label=t) for t, c in color_mapa.items()]\n",
    "ax.legend(handles=leyenda, loc=\"lower right\")\n",
    "ax.grid(axis=\"x\", alpha=0.3)\n",
    "ax.axvline(0, color=COLORS[\"neutral\"], linewidth=0.8)\n",
    "\n",
    "plt.tight_layout()\n",
    "fig.savefig(OUT_FIGURES / \"11_importancia_variables_DCSA.png\",\n",
    "            dpi=300, bbox_inches=\"tight\", facecolor=\"white\")\n",
    "plt.show()"
   ]
  },
