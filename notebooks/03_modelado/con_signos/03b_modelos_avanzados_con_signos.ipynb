    "    print(f\"✅ {nombre} guardado\")\n",
    "\n",
    "# Checkpoint del mejor modelo\n",
    "joblib.dump(\n",
    "    {\n",
    "        \"mejor_modelo\":   mejor_nombre,\n",
    "        \"pipeline\":       modelos_entrenados[mejor_nombre][\"pipeline\"],\n",
    "        \"features\":       FEATURES,\n",
    "        \"tabla_test\":     tabla_test,\n",
    "        \"df_importancia\": df_imp,\n",
    "    },\n",
    "    CHECKPOINTS / \"03b_mejor_modelo_DCSA.pkl\"\n",
    ")\n",
    "\n",
    "print(f\"\\n✅ Mejor modelo: {mejor_nombre}\")\n",
