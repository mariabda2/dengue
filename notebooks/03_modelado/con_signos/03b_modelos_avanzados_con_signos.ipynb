    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# PERSISTENCIA DE MODELOS\n",
    "# Se guardan el mejor pipeline completo (preprocesador + SMOTE + modelo)\n",
    "# para que pueda usarse directamente para predicción sin reentrenar.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "for nombre, res in modelos_entrenados.items():\n",
