    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# ANÁLISIS BIVARIADO — DSSA\n",
    "# En DSSA la hospitalización es rara (~8%), por lo que:\n",
    "# 1. Muchas OR serán cercanas a 1 (escasa variación clínica)\n",
    "# 2. Los IC95% serán anchos (poca potencia estadística)\n",
    "# 3. Las pruebas de Fisher son más apropiadas que chi-cuadrado\n",
    "#    cuando hay celdas con conteos bajos.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "tabla_bivariado_sin = analisis_bivariado(\n",
    "    df_sin, todas_clinicas, TARGET_COL, \"DSSA\"\n",
    ")\n",
    "display(tabla_bivariado_sin)\n",
    "tabla_bivariado_sin.to_csv(OUT_TABLES / \"bivariado_DSSA_todas_variables.csv\", index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# COMPARATIVA: OR CRUDO EN DCSA vs DSSA\n",
    "# Este gráfico permite identificar si un mismo síntoma tiene\n",
    "# distinta capacidad discriminativa según el estrato clínico.\n",
    "# Diferencias marcadas entre estratos sugieren heterogeneidad\n",
    "# clínica que justifica el modelado estratificado.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "comparativa = tabla_bivariado_con[[\"Variable\", \"OR\"]].merge(\n",
    "    tabla_bivariado_sin[[\"Variable\", \"OR\"]],\n",
    "    on=\"Variable\", suffixes=(\"_DCSA\", \"_DSSA\")\n",
    ").dropna()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 7))\n",
    "\n",
    "comparativa = comparativa.sort_values(\"OR_DCSA\")\n",
    "y = range(len(comparativa))\n",
    "\n",
    "ax.barh([i - 0.2 for i in y], comparativa[\"OR_DCSA\"],\n",
    "        height=0.35, color=COLORS[\"con_signos\"], alpha=0.85, label=\"Con signos (DCSA)\")\n",
    "ax.barh([i + 0.2 for i in y], comparativa[\"OR_DSSA\"],\n",
    "        height=0.35, color=COLORS[\"sin_signos\"], alpha=0.85, label=\"Sin signos (DSSA)\")\n",
    "\n",
    "ax.axvline(1, color=COLORS[\"neutral\"], linestyle=\"--\", linewidth=1.2)\n",
    "ax.set_yticks(list(y))\n",
    "ax.set_yticklabels(comparativa[\"Variable\"], fontsize=9)\n",
    "ax.set_xlabel(\"Odds Ratio crudo\")\n",
    "ax.set_title(\"Comparativa de OR crudos: DCSA vs DSSA\\n\"\n",
    "             \"(asociación con hospitalización por estrato clínico)\")\n",
    "ax.legend()\n",
    "ax.grid(axis=\"x\", alpha=0.3)\n",
    "plt.tight_layout()\n",
    "\n",
    "fig.savefig(OUT_FIGURES / \"06_comparativa_OR_DCSA_DSSA.png\",\n",
    "            dpi=300, bbox_inches=\"tight\", facecolor=\"white\")\n",
    "plt.show()\n",
    "print(\"✅ Figura comparativa guardada\")"
   ]
