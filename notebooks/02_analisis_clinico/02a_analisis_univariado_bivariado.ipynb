    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# FOREST PLOT — OR CRUDO (DCSA)\n",
    "# El forest plot es el estándar de visualización en epidemiología clínica\n",
    "# para comunicar asociaciones con sus intervalos de confianza.\n",
    "# La línea vertical en OR=1 indica ausencia de asociación.\n",
    "# Variables a la derecha de OR=1 se asocian positivamente con hospitalización.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def forest_plot(tabla, titulo, nombre_archivo, colores_map=None):\n",
    "    \"\"\"Forest plot de OR con IC95% para variables clínicas.\"\"\"\n",
    "    df_plot = tabla.dropna(subset=[\"OR\"]).sort_values(\"OR\")\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(10, 7))\n",
    "\n",
    "    y_pos = range(len(df_plot))\n",
    "\n",
    "    # Colores por tipo de variable\n",
    "    if colores_map:\n",
    "        colors = [colores_map.get(v, COLORS[\"neutral\"]) for v in df_plot[\"Variable\"]]\n",
    "    else:\n",
    "        colors = [\n",
    "            COLORS[\"con_signos\"] if v in SIGNOS_ALARMA else COLORS[\"sin_signos\"]\n",
    "            for v in df_plot[\"Variable\"]\n",
    "        ]\n",
    "\n",
    "    for i, (_, fila) in enumerate(df_plot.iterrows()):\n",
    "        color = COLORS[\"con_signos\"] if fila[\"Variable\"] in SIGNOS_ALARMA else COLORS[\"sin_signos\"]\n",
    "        marker = \"D\" if fila[\"Significativo\"] else \"o\"\n",
    "        ax.errorbar(\n",
    "            x=fila[\"OR\"], y=i,\n",
    "            xerr=[[fila[\"OR\"] - fila[\"IC95_inf\"]], [fila[\"IC95_sup\"] - fila[\"OR\"]]],\n",
    "            fmt=marker, capsize=4, markersize=8, color=color,\n",
    "            elinewidth=1.5, markeredgecolor=\"white\", markeredgewidth=0.8\n",
    "        )\n",
    "        # Etiqueta OR\n",
    "        ax.text(fila[\"IC95_sup\"] + 0.05, i,\n",
    "                f\"{fila['OR']:.2f} [{fila['IC95_inf']:.2f}–{fila['IC95_sup']:.2f}]\",\n",
    "                va=\"center\", fontsize=8)\n",
    "\n",
    "    ax.set_yticks(range(len(df_plot)))\n",
    "    ax.set_yticklabels(df_plot[\"Variable\"], fontsize=9)\n",
    "    ax.axvline(1, color=COLORS[\"neutral\"], linestyle=\"--\", linewidth=1.2, alpha=0.8)\n",
    "    ax.set_xlabel(\"Odds Ratio crudo (IC 95%)\")\n",
    "    ax.set_title(titulo)\n",
    "\n",
    "    # Leyenda\n",
    "    leyenda = [\n",
    "        mpatches.Patch(color=COLORS[\"con_signos\"], label=\"Signo de alarma\"),\n",
    "        mpatches.Patch(color=COLORS[\"sin_signos\"], label=\"Síntoma general\"),\n",
    "        plt.Line2D([0], [0], marker=\"D\", color=\"gray\", label=\"p_adj < 0.05\",\n",
    "                   markerfacecolor=\"gray\", markersize=8, linewidth=0),\n",
    "        plt.Line2D([0], [0], marker=\"o\", color=\"gray\", label=\"p_adj ≥ 0.05\",\n",
    "                   markerfacecolor=\"gray\", markersize=8, linewidth=0),\n",
    "    ]\n",
    "    ax.legend(handles=leyenda, loc=\"lower right\", fontsize=9)\n",
    "    ax.set_xlim(0, df_plot[\"IC95_sup\"].max() + 1)\n",
    "    ax.grid(axis=\"x\", alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "\n",
    "    fig.savefig(OUT_FIGURES / nombre_archivo, dpi=300, bbox_inches=\"tight\", facecolor=\"white\")\n",
    "    plt.show()\n",
    "    print(f\"✅ Figura guardada: {nombre_archivo}\")\n",
    "\n",
    "\n",
    "forest_plot(\n",
    "    tabla_bivariado_con,\n",
    "    \"Forest plot — OR crudo (Dengue con signos de alarma)\",\n",
    "    \"04_forest_plot_crudo_DCSA.png\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# HEATMAP DE COOCURRENCIA DE SÍNTOMAS\n",
    "# Evalúa la colinealidad entre variables clínicas.\n",
    "# Una alta coocurrencia (correlación phi > 0.5) indica que dos variables\n",
    "# aportan información redundante al modelo predictivo.\n",
    "# La correlación phi es la equivalente a Pearson para variables binarias.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# Binarizar variables (1=presente, 0=ausente)\n",
    "df_binario = df_con[todas_clinicas].replace({1: 1, 2: 0})\n",
    "\n",
    "# Correlación phi (equivalente a Pearson para binarias)\n",
    "corr_matrix = df_binario.corr(method=\"pearson\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(12, 10))\n",
    "\n",
    "mascara_diagonal = np.eye(len(corr_matrix), dtype=bool)\n",
    "\n",
    "sns.heatmap(\n",
    "    corr_matrix,\n",
    "    mask=mascara_diagonal,\n",
    "    annot=True, fmt=\".2f\",\n",
    "    cmap=\"RdBu_r\", center=0,\n",
    "    vmin=-0.5, vmax=0.5,\n",
    "    linewidths=0.5, linecolor=\"white\",\n",
    "    annot_kws={\"size\": 8},\n",
    "    square=True, ax=ax\n",
    ")\n",
    "\n",
    "ax.set_title(\n",
    "    \"Correlación phi entre manifestaciones clínicas del dengue\\n\"\n",
    "    \"(Dengue con signos de alarma — Bucaramanga)\",\n",
    "    fontsize=13, fontweight=\"bold\"\n",
    ")\n",
    "\n",
    "# Línea separadora entre síntomas generales y signos de alarma\n",
    "n_generales = len(SINTOMAS_GENERALES)\n",
    "ax.axhline(n_generales, color=\"black\", linewidth=2)\n",
    "ax.axvline(n_generales, color=\"black\", linewidth=2)\n",
    "\n",
    "ax.text(n_generales / 2, -0.8, \"Síntomas generales\",\n",
    "        ha=\"center\", fontsize=10, color=COLORS[\"sin_signos\"], fontweight=\"bold\")\n",
    "ax.text(n_generales + len(SIGNOS_ALARMA) / 2, -0.8, \"Signos de alarma\",\n",
    "        ha=\"center\", fontsize=10, color=COLORS[\"con_signos\"], fontweight=\"bold\")\n",
    "\n",
    "plt.tight_layout()\n",
    "fig.savefig(OUT_FIGURES / \"05_heatmap_correlacion_sintomas.png\",\n",
    "            dpi=300, bbox_inches=\"tight\", facecolor=\"white\")\n",
    "plt.show()\n",
    "print(\"✅ Heatmap de correlación guardado\")"
   ]
  },
