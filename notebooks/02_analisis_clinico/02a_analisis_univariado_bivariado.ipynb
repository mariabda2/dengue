    "## 1. Función de análisis bivariado\n",
    "\n",
    "Se implementa una función genérica que calcula, para cada variable clínica binaria:\n",
    "- Tabla de contingencia 2×2\n",
    "- Odds Ratio crudo con IC95% (Woolf method)\n",
    "- p-valor (chi-cuadrado o Fisher cuando n < 5 en alguna celda)\n",
    "- p-valor ajustado por Benjamini-Hochberg (FDR)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# FUNCIÓN DE ANÁLISIS BIVARIADO\n",
    "# Calcula OR crudo, IC95% y p-valor para variables binarias (1/2) vs target (0/1).\n",
    "# Aplica corrección Benjamini-Hochberg (FDR) para comparaciones múltiples:\n",
    "# con 17 variables clínicas, el riesgo de falsos positivos por azar es alto\n",
    "# si se usa el p-valor bruto sin ajuste.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "def analisis_bivariado(df, variables, target_col, etiqueta_df=\"\"):\n",
    "    \"\"\"Calcula OR crudo, IC95% y p-valor para cada variable vs target.\"\"\"\n",
    "    resultados = []\n",
    "\n",
    "    for var in variables:\n",
    "        # Binarizar (1=presente, 2=ausente → 1=sí, 0=no)\n",
    "        presente = df[var].map({1: 1, 2: 0}).dropna()\n",
    "        target   = df.loc[presente.index, target_col].dropna()\n",
    "\n",
    "        # Tabla de contingencia\n",
    "        tabla = pd.crosstab(presente, target)\n",
    "        if tabla.shape != (2, 2):\n",
    "            resultados.append({\"Variable\": var, \"OR\": np.nan,\n",
    "                                \"IC95_inf\": np.nan, \"IC95_sup\": np.nan,\n",
    "                                \"p_valor\": np.nan, \"Nota\": \"tabla incompleta\"})\n",
    "            continue\n",
    "\n",
    "        a, b = tabla.iloc[1, 1], tabla.iloc[1, 0]  # presente: hosp / no hosp\n",
    "        c, d = tabla.iloc[0, 1], tabla.iloc[0, 0]  # ausente:  hosp / no hosp\n",
    "\n",
    "        # OR y IC95% (método de Woolf)\n",
    "        if 0 in [a, b, c, d]:\n",
    "            # Corrección de 0.5 para celdas vacías\n",
    "            a, b, c, d = a + 0.5, b + 0.5, c + 0.5, d + 0.5\n",
    "\n",
    "        OR  = (a * d) / (b * c)\n",
    "        log_OR = np.log(OR)\n",
    "        se = np.sqrt(1/a + 1/b + 1/c + 1/d)\n",
    "        IC_inf = np.exp(log_OR - 1.96 * se)\n",
    "        IC_sup = np.exp(log_OR + 1.96 * se)\n",
    "\n",
    "        # p-valor\n",
    "        min_esperado = min((a * (a + b)) / (a + b + c + d),\n",
    "                           (c * (c + d)) / (a + b + c + d))\n",
    "        if min_esperado < 5:\n",
    "            _, p = fisher_exact([[a, b], [c, d]])\n",
    "            test = \"Fisher\"\n",
    "        else:\n",
    "            _, p, _, _ = chi2_contingency([[a, b], [c, d]])\n",
    "            test = \"Chi2\"\n",
    "\n",
    "        # Prevalencia en hospitalizados y no hospitalizados\n",
    "        pct_hosp   = tabla.iloc[1, 1] / tabla.iloc[:, 1].sum() * 100\n",
    "        pct_no_hosp = tabla.iloc[1, 0] / tabla.iloc[:, 0].sum() * 100\n",
    "\n",
    "        resultados.append({\n",
    "            \"Variable\":   var,\n",
    "            \"N_total\":    len(presente),\n",
    "            \"Hosp_%\":     round(pct_hosp, 1),\n",
    "            \"NoHosp_%\":   round(pct_no_hosp, 1),\n",
    "            \"OR\":         round(OR, 3),\n",
    "            \"IC95_inf\":   round(IC_inf, 3),\n",
    "            \"IC95_sup\":   round(IC_sup, 3),\n",
    "            \"p_valor\":    p,\n",
    "            \"Test\":       test,\n",
    "        })\n",
    "\n",
    "    tabla_res = pd.DataFrame(resultados)\n",
    "\n",
    "    # Corrección FDR (Benjamini-Hochberg)\n",
    "    pvals = tabla_res[\"p_valor\"].fillna(1).values\n",
    "    _, p_adj, _, _ = multipletests(pvals, method=\"fdr_bh\")\n",
    "    tabla_res[\"p_adj_BH\"] = p_adj.round(4)\n",
    "    tabla_res[\"Significativo\"] = tabla_res[\"p_adj_BH\"] < 0.05\n",
    "\n",
    "    print(f\"\\n── Análisis bivariado: {etiqueta_df} ({len(df):,} registros) ──\")\n",
    "    return tabla_res.sort_values(\"OR\", ascending=False)\n",
    "\n",
    "print(\"✅ Función lista\")"
   ]
  },
