    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# ANÁLISIS BIVARIADO — DCSA (Dengue Con Signos de Alarma)\n",
    "# Todas las variables clínicas: síntomas generales + signos de alarma\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "todas_clinicas = SINTOMAS_GENERALES + SIGNOS_ALARMA\n",
    "\n",
    "tabla_bivariado_con = analisis_bivariado(\n",
