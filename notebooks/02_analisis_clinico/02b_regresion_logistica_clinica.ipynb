    "\n",
    "print(\"✅ Checkpoints guardados:\")\n",
    "print(f\"   Modelos logísticos: {CHECKPOINTS / '02b_modelos_logisticos.pkl'}\")\n",
    "print(f\"   Tabla OR: {CHECKPOINTS / '02b_tabla_OR_ajustados_DCSA.pkl'}\")"
   ]
