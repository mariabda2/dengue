    "df_con_signos = df[df[\"CLASFINAL\"].eq(\"DENGUE CON SIGNOS DE ALARMA\")].copy()\n",
    "df_sin_signos = df[df[\"CLASFINAL\"].eq(\"DENGUE SIN SIGNOS DE ALARMA\")].copy()\n",
    "\n",
    "joblib.dump(df, CHECKPOINTS / \"01_df_completo_post_eda.pkl\")\n",
