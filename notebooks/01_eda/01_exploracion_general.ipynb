    "## 8. Distribución sociodemográfica"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# PERFIL SOCIODEMOGRÁFICO DE LA COHORTE\n",
    "# El dengue en Colombia muestra gradientes socioeconómicos marcados:\n",
    "# estratos bajos tienen mayor exposición al vector por condiciones de\n",
    "# saneamiento y acceso irregular a agua. El tipo de aseguramiento\n",
    "# (TIP_SS_) refleja tanto nivel socioeconómico como acceso al sistema de salud.\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "fig, axes = plt.subplots(2, 2, figsize=(16, 12))\n",
    "\n",
    "# ── Panel A: Distribución por sexo ───────────────────────────────────────────\n",
    "ax = axes[0, 0]\n",
    "sexo_hosp = pd.crosstab(\n",
    "    df[\"SEXO_\"].map({1: \"Masculino\", 2: \"Femenino\"}),\n",
    "    df[TARGET_COL].map({1: \"Hospitalizado\", 0: \"No hospitalizado\"}),\n",
    "    normalize=\"index\"\n",
    ") * 100\n",
    "sexo_hosp.plot(kind=\"bar\", ax=ax, color=[COLORS[\"primary\"], COLORS[\"secondary\"]],\n",
    "               width=0.6, edgecolor=\"white\")\n",
    "ax.set_title(\"A. Hospitalización por sexo\")\n",
    "ax.set_xlabel(\"\")\n",
    "ax.set_ylabel(\"Porcentaje (%)\")\n",
    "ax.tick_params(axis=\"x\", rotation=0)\n",
    "ax.legend(title=\"\")\n",
    "ax.set_ylim(0, 100)\n",
    "\n",
    "# ── Panel B: Distribución por grupo etario ───────────────────────────────────\n",
    "ax = axes[0, 1]\n",
    "etario_hosp = (\n",
    "    df.groupby(\"DEF_CLAS_EDAD\")[TARGET_COL]\n",
    "    .agg(Total=\"size\", Hosp=lambda x: x.eq(1).sum())\n",
    "    .reset_index()\n",
    ")\n",
    "etario_hosp[\"Pct\"] = (etario_hosp[\"Hosp\"] / etario_hosp[\"Total\"] * 100).round(1)\n",
    "etario_hosp = etario_hosp.sort_values(\"DEF_CLAS_EDAD\")\n",
    "\n",
    "bars = ax.bar(etario_hosp[\"DEF_CLAS_EDAD\"].astype(str), etario_hosp[\"Pct\"],\n",
    "              color=COLORS[\"accent\"], edgecolor=\"white\")\n",
    "ax.bar_label(bars, fmt=\"%.1f%%\", fontsize=8, padding=2)\n",
    "ax.set_title(\"B. Tasa de hospitalización por grupo etario\")\n",
    "ax.set_xlabel(\"Grupo etario\")\n",
    "ax.set_ylabel(\"% hospitalizado\")\n",
    "ax.tick_params(axis=\"x\", rotation=45)\n",
    "\n",
    "# ── Panel C: Por tipo de aseguramiento ───────────────────────────────────────\n",
    "ax = axes[1, 0]\n",
    "ss_map = {1: \"Contributivo\", 2: \"Subsidiado\", 3: \"Vinculado\",\n",
    "          4: \"Excepción\", 5: \"Especial\", 6: \"No asegurado\"}\n",
    "ss_hosp = (\n",
    "    df.groupby(df[\"TIP_SS_\"].map(ss_map).fillna(\"Otro\"))[TARGET_COL]\n",
    "    .agg(Total=\"size\", Hosp=lambda x: x.eq(1).sum())\n",
    "    .reset_index()\n",
    ")\n",
    "ss_hosp[\"Pct\"] = (ss_hosp[\"Hosp\"] / ss_hosp[\"Total\"] * 100).round(1)\n",
    "ss_hosp = ss_hosp.sort_values(\"Pct\", ascending=True)\n",
    "bars = ax.barh(ss_hosp[\"TIP_SS_\"], ss_hosp[\"Pct\"],\n",
    "               color=COLORS[\"primary\"], alpha=0.8)\n",
    "ax.bar_label(bars, fmt=\"%.1f%%\", padding=3, fontsize=9)\n",
    "ax.set_title(\"C. Hospitalización por tipo de aseguramiento\")\n",
    "ax.set_xlabel(\"% hospitalizado\")\n",
    "\n",
    "# ── Panel D: Por estrato socioeconómico ──────────────────────────────────────\n",
    "ax = axes[1, 1]\n",
    "estrato_hosp = (\n",
    "    df.groupby(\"ESTRATO_\")[TARGET_COL]\n",
    "    .agg(Total=\"size\", Hosp=lambda x: x.eq(1).sum())\n",
    "    .reset_index()\n",
    ")\n",
    "estrato_hosp[\"Pct\"] = (estrato_hosp[\"Hosp\"] / estrato_hosp[\"Total\"] * 100).round(1)\n",
    "bars = ax.bar(estrato_hosp[\"ESTRATO_\"].astype(str), estrato_hosp[\"Pct\"],\n",
    "              color=[plt.cm.Blues(0.3 + i * 0.12) for i in range(len(estrato_hosp))],\n",
    "              edgecolor=\"white\")\n",
    "ax.bar_label(bars, fmt=\"%.1f%%\", fontsize=8, padding=2)\n",
    "ax.set_title(\"D. Hospitalización por estrato socioeconómico\")\n",
    "ax.set_xlabel(\"Estrato\")\n",
    "ax.set_ylabel(\"% hospitalizado\")\n",
    "\n",
    "plt.suptitle(\"Perfil sociodemográfico y tasas de hospitalización — Dengue Bucaramanga\",\n",
    "             fontsize=14, fontweight=\"bold\", y=1.01)\n",
    "plt.tight_layout()\n",
    "\n",
    "fig.savefig(OUT_FIGURES / \"03_perfil_sociodemografico.png\",\n",
    "            dpi=300, bbox_inches=\"tight\", facecolor=\"white\")\n",
    "plt.show()"
   ]
