    "joblib.dump(df_sin_signos, DATA_INTERIM / \"datos_sin_signos.pkl\")\n",
    "\n",
    "print(\"✅ Checkpoints guardados:\")\n",
    "print(f\"   df completo      : {df.shape[0]:,} registros → {CHECKPOINTS / '01_df_completo_post_eda.pkl'}\")\n",
    "print(f\"   Con signos (DCSA): {df_con_signos.shape[0]:,} registros → {DATA_INTERIM / 'datos_con_signos.pkl'}\")\n",
    "print(f\"   Sin signos (DSSA): {df_sin_signos.shape[0]:,} registros → {DATA_INTERIM / 'datos_sin_signos.pkl'}\")"
